# Copy to .env.local for local development. Never commit real values.

# Local dev: the embedded Postgres started by `npm run db:start` listens on 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/expense_tracker

# Public origin of the app (used for absolute URLs). Production: https://your-domain
APP_ORIGIN=http://localhost:3000

# trace | debug | info | warn | error
LOG_LEVEL=info

# Gmail capture (optional; see docs/setup/gmail.md). Without these, Gmail shows "Not configured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# How far back the first Gmail check looks (days)
GMAIL_BACKFILL_DAYS=60
