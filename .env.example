# Copy to .env.local for local development. Never commit real values.

# Local dev: the embedded Postgres started by `npm run db:start` listens on 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/expense_tracker

# Public origin of the app (used for absolute URLs). Production: https://your-domain
APP_ORIGIN=http://localhost:3000

# trace | debug | info | warn | error
LOG_LEVEL=info
