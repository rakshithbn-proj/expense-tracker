# Copy to `.env` next to compose.yaml on the VPS (chmod 600). Never commit the real file.
DOMAIN=expenses.example.com
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Gmail capture (docs/setup/gmail.md). Leave empty until you set it up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32   (keep a copy: losing it means reconnecting Gmail)
TOKEN_ENCRYPTION_KEY=
