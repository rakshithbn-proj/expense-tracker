# Copy to `.env` next to compose.yaml on the VPS (chmod 600). Never commit the real file.
DOMAIN=expenses.example.com
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Gmail capture (docs/setup/gmail.md). Leave empty until you set it up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32   (keep a copy: losing it means reconnecting Gmail)
TOKEN_ENCRYPTION_KEY=

# Your own name(s) as bank alerts print them, comma-separated (e.g. "A B KUMAR,AB KUMAR").
# A payment "transferred to" or "received from" one of these is an own-account transfer, not spending.
OWN_ACCOUNT_NAMES=

# Only when an existing Traefik already serves 80/443 (deploy/compose.traefik.yaml); Caddy is then off.
#COMPOSE_FILE=compose.yaml:deploy/compose.traefik.yaml
#TRAEFIK_NETWORK=root_default
#TRAEFIK_CERTRESOLVER=mytlschallenge
